# --- Python / venv ---
venv/
.env
.env.*
*.pyc
__pycache__/
*.pyo
*.pyd
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.dmypy.json

# --- macOS / IDE ---
.DS_Store
*.code-workspace
.vscode/
.idea/

# --- Build / dist / coverage ---
build/
dist/
*.egg-info/
.eggs/
.coverage
.coverage.*
htmlcov/

# --- Logs ---
logs/
*.log

# --- Datasets (adjust if you want to version some) ---
data/raw/
data/interim/
data/processed/
data/external/

# --- Model artifacts & metrics (usually generated) ---
reports/models/
reports/metrics/
# Keep an empty placeholder if needed:
!/reports/models/.gitkeep
!/reports/metrics/.gitkeep

# --- Explainability / visual artifacts ---
reports/explain/*
!/reports/explain/.gitkeep

# --- Checkpoints / temp ---
**/.ipynb_checkpoints/
.tmp/
tmp/
.cache/

# --- Serialized objects ---
*.joblib
*.pkl
*.pickle

# --- Front-end compiled assets (if any) ---
src/static/compiled/
node_modules/

# --- Local run files ---
.venv/
